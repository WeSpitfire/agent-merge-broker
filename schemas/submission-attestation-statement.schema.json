{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "_type": {
      "type": "string",
      "const": "https://in-toto.io/Statement/v1"
    },
    "subject": {
      "type": "array",
      "prefixItems": [
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "git-commit"
            },
            "digest": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "sha1": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "sha1"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "name",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "const": "git-tree"
            },
            "digest": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "sha1": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "sha1"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "sha256": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "sha256"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "name",
            "digest"
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "predicateType": {
      "type": "string",
      "const": "urn:agent-merge-broker:gate-validation:v1"
    },
    "predicate": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "purpose": {
          "type": "string",
          "const": "validation-evidence"
        },
        "mergeAuthorized": {
          "type": "boolean",
          "const": false
        },
        "submissionId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{0,127}$"
        },
        "authorityDigest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "base": {
          "type": "object",
          "properties": {
            "sha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "ref": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "baseBranch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "remote": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "fetchUrlFingerprint": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sha",
            "ref",
            "baseBranch",
            "remote"
          ],
          "additionalProperties": false
        },
        "policy": {
          "type": "object",
          "properties": {
            "baseSha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "configPath": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "configBlobSha": {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "revision": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "evaluatorVersion": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "configVersion": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "baseSha",
            "configPath",
            "configBlobSha",
            "digest",
            "revision",
            "evaluatorVersion",
            "configVersion"
          ],
          "additionalProperties": false
        },
        "outcome": {
          "type": "string",
          "enum": [
            "validated",
            "rejected",
            "failed"
          ]
        },
        "validators": {
          "maxItems": 10000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "scope": {
                "type": "string",
                "enum": [
                  "focused",
                  "authoritative"
                ]
              },
              "startedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "finishedAt": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              },
              "durationMs": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "exitCode": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "name",
              "scope",
              "startedAt",
              "finishedAt",
              "durationMs",
              "exitCode"
            ],
            "additionalProperties": false
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "validationStartedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "retentionCompromisedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        "errorCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        }
      },
      "required": [
        "version",
        "purpose",
        "mergeAuthorized",
        "submissionId",
        "authorityDigest",
        "base",
        "policy",
        "outcome",
        "validators",
        "createdAt",
        "finishedAt"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "_type",
    "subject",
    "predicateType",
    "predicate"
  ],
  "$id": "urn:agent-merge-broker:schema:submission-attestation-statement:v1",
  "title": "Agent Merge Broker Gate validation in-toto statement v1",
  "description": "Structural schema for Gate validation evidence. Verification additionally checks signatures, expected commit/tree/base/policy/authority, and consistency of outcomes and timestamps. Evidence never grants merge authorization."
}
