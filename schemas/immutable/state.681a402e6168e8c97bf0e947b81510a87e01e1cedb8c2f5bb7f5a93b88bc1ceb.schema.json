    "tasks": {
      "type": "object",
      "description": "Records keyed by their id; each record's id must equal its key.",
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    },
    "batches": {
      "type": "object",
      "description": "Records keyed by their id; each record's id must equal its key.",
      "additionalProperties": {
        "$ref": "#/$defs/batch"
      }
    },
    "submissions": {
      "type": "object",
      "description": "Records keyed by their id; each record's id must equal its key.",
