{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WeSpitfire/agent-merge-broker/raw/main/schemas/provenance.schema.json",
  "title": "Agent Merge Broker batch provenance",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generator", "batchId", "baseBranch", "baseSha", "integratedHeadSha", "taskIds", "tasks", "validations", "createdAt"],
  "properties": {
    "version": { "const": 1 },
    "generator": { "const": "agent-merge-broker" },
    "batchId": { "type": "string", "minLength": 1 },
    "baseBranch": { "type": "string", "minLength": 1 },
    "history": {
      "enum": ["preserve", "squash"],
      "description": "How the batch was assembled. Squashing drops the cherry-pick trail, so a verifier cannot trace submitted commits in the integrated history. Absent on manifests written before this field existed, which always preserved history.",
      "default": "preserve"
    },
    "baseSha": { "$ref": "#/$defs/sha" },
    "integratedHeadSha": { "$ref": "#/$defs/sha" },
    "taskIds": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "commits", "actualPaths", "dependsOn"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "commits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha" } },
          "actualPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    },
    "validations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "scope", "exitCode", "durationMs"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["focused", "authoritative"] },
          "taskId": { "type": "string", "minLength": 1 },
          "exitCode": { "const": 0 },
          "durationMs": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }
      }
    }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
  }
}
