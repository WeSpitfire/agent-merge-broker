{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WeSpitfire/agent-merge-broker/raw/main/schemas/receipt.schema.json",
  "title": "Agent Merge Broker commit receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "taskId",
    "baseSha",
    "commits",
    "expectedPaths",
    "actualPaths",
    "dependsOn",
    "submittedAt",
    "warnings"
  ],
  "properties": {
    "version": { "const": 1 },
    "taskId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:@/-]{0,127}$"
    },
    "agent": { "type": "string", "minLength": 1 },
    "baseSha": { "$ref": "#/$defs/sha" },
    "commits": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/sha" } },
    "expectedPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "actualPaths": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "dependsOn": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "worktree": { "type": "string", "minLength": 1 },
    "submittedAt": { "type": "string", "format": "date-time" },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" }
  }
}
